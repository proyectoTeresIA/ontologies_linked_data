@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org/> .

ex:concept1 a ontolex:LexicalConcept ;
  skos:prefLabel "Test concept"@en ;
  skos:definition "A simple concept"@en .

ex:entry1 a ontolex:LexicalEntry ;
  ontolex:canonicalForm ex:form1 ;
  ontolex:sense ex:sense1 ;
  ontolex:evokes ex:concept1 .

ex:form1 a ontolex:Form ;
  ontolex:writtenRep "test"@en .

ex:sense1 a ontolex:LexicalSense ;
  dct:definition "Definition text"@en ;
  ontolex:isLexicalizedSenseOf ex:concept1 .
